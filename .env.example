# Discord Bot Token (REQUIRED)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID (REQUIRED for slash commands)
# Found in Discord Developer Portal → General Information
CLIENT_ID=your_application_id_here

# Discord Guild ID (Optional - for testing slash commands in one server)
# Right-click your server → Copy Server ID (enable Developer Mode first)
GUILD_ID=your_test_guild_id_here

# Moderation Log Channel ID (Optional but recommended)
# The channel where mod actions are logged
MOD_LOG_CHANNEL_ID=your_mod_log_channel_id

# Auto-Mod Configuration (Optional)
ENABLE_AUTOMOD=true
MAX_WARNINGS_BEFORE_ACTION=3
AUTO_TIMEOUT_DURATION=3600

# Database Path (Optional - defaults to ./data/moderation.db)
DATABASE_PATH=./data/moderation.db
