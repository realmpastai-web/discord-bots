# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Development Server (for slash command registration)
GUILD_ID=your_test_server_id

# Optional: Default mod log channel
MOD_LOG_CHANNEL=

# Optional: Database path (default: ./data/moderation.db)
DATABASE_PATH=./data/moderation.db

# Node Environment
NODE_ENV=production