# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# Log Channel ID (optional but recommended)
# Right-click your mod-logs channel → Copy Channel ID
LOG_CHANNEL_ID=

# Warning System Settings
WARN_THRESHOLD=3

# Anti-Spam Settings
SPAM_THRESHOLD=5
SPAM_WINDOW=5000

# Banned Words (comma-separated, no spaces)
# Example: BANNED_WORDS=spam,toxic,gore
BANNED_WORDS=
